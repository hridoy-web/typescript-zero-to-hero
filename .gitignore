@"
# Dependencies (pnpm and npm)
node_modules/
.pnpm-store/

# Build outputs
dist/
*.tsbuildinfo

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & Editor files
.DS_Store
Thumbs.db
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
"@ | Set-Content -Path ".gitignore" -Encoding utf8